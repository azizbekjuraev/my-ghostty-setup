# ╔═══════════════════════════════════════════════════╗
# ║         ghostty/config — Zenwritten               ║
# ╚═══════════════════════════════════════════════════╝
# ── Font ──────────────────────────────────────────────
font-size = 14
# font-family = "JetBrainsMono Nerd Font"
# ── Cursor ────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
cursor-color = #89A39C
cursor-text = #16161D
# ── Selection ─────────────────────────────────────────
selection-background = #2E2E36
selection-foreground = #BBBBBB
# ── Window ────────────────────────────────────────────
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
window-padding-color = background
# ── Zenwritten — Core ─────────────────────────────────
background = #16161D
foreground = #BBBBBB
# ── Zenwritten — 16-color Palette ─────────────────────
# Normal (0–7): black red green yellow blue magenta cyan white
palette = 0=#252530
palette = 1=#A8334C
palette = 2=#4F6C31
palette = 3=#944927
palette = 4=#286486
palette = 5=#88507D
palette = 6=#3B8992
palette = 7=#BBBBBB
# Bright (8–15)
palette = 8=#3E3E43
palette = 9=#C57385
palette = 10=#88B379
palette = 11=#B07159
palette = 12=#6099C0
palette = 13=#BB8DAE
palette = 14=#78AFAF
palette = 15=#CCCCCC
# ── Shell integration ─────────────────────────────────
shell-integration-features = cursor,sudo,title
