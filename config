# ╔═══════════════════════════════════════════════════╗
# ║         ghostty/config — Everforest Dark          ║
# ╚═══════════════════════════════════════════════════╝
# ── Font ──────────────────────────────────────────────
font-size = 14
# font-family = "JetBrainsMono Nerd Font"
# ── Cursor ────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
cursor-color = #83C092
cursor-text = #2D353B
# ── Selection ─────────────────────────────────────────
selection-background = #3D484D
selection-foreground = #D3C6AA
# ── Window ────────────────────────────────────────────
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
window-padding-color = background
# ── Everforest — Core ─────────────────────────────────
background = #2D353B
foreground = #D3C6AA
# ── Everforest — 16-color Palette ─────────────────────
palette = 0=#374145
palette = 1=#E67E80
palette = 2=#A7C080
palette = 3=#DBBC7F
palette = 4=#7FBBB3
palette = 5=#D699B6
palette = 6=#83C092
palette = 7=#D3C6AA
palette = 8=#3D484D
palette = 9=#E67E80
palette = 10=#A7C080
palette = 11=#DBBC7F
palette = 12=#7FBBB3
palette = 13=#D699B6
palette = 14=#83C092
palette = 15=#E6DFC8
# ── Shell integration ─────────────────────────────────
shell-integration-features = cursor,sudo,title
